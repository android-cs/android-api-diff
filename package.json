{
  "name": "android-api-diff",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -F web exec vite",
    "build": "pnpm -F web exec vite build",
    "preview": "pnpm -F web exec vite preview",
    "format": "prettier --cache --write --ignore-unknown ."
  },
  "dependencies": {
    "@tsconfig/node20": "20.1.9",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.6.2",
    "@vitejs/plugin-legacy": "8.0.1",
    "@vitejs/plugin-vue": "6.0.6",
    "@vue/tsconfig": "0.9.1",
    "@vueuse/core": "14.3.0",
    "@vueuse/router": "14.3.0",
    "antlr4": "4.13.2",
    "localforage": "1.10.0",
    "lodash-es": "4.18.1",
    "normalize.css": "8.0.1",
    "p-limit": "7.3.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "unocss": "66.6.8",
    "unplugin-data": "0.1.1",
    "unplugin-import-defer": "^0.2.0",
    "vite": "8.0.12",
    "vue": "3.5.34",
    "vue-router": "5.0.6"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "volta": {
    "node": "24.11.1",
    "pnpm": "11.0.9"
  }
}
