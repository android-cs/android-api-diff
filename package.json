{
  "name": "android-api-diff",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "type-check": "pnpm -r type-check",
    "dev": "pnpm -F @android-cs/web dev",
    "build": "pnpm -F @android-cs/web build",
    "preview": "pnpm -F @android-cs/web preview",
    "format": "prettier --cache --write --ignore-unknown ."
  },
  "dependencies": {
    "@tsconfig/node20": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-legacy": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/router": "catalog:",
    "antlr4": "catalog:",
    "idb": "catalog:",
    "lodash-es": "catalog:",
    "normalize.css": "catalog:",
    "p-limit": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unplugin-data": "catalog:",
    "unplugin-import-defer": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.7.0",
      "onFail": "error"
    }
  }
}
