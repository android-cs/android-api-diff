{
  "name": "@android-cs/android-api-diff-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.5.0"
  },
  "scripts": {
    "type-check": "pnpm -r type-check",
    "dev": "pnpm -F @android-cs/web dev",
    "build": "pnpm -F @android-cs/web build",
    "preview": "pnpm -F @android-cs/web preview",
    "format": "prettier --cache --write --ignore-unknown ."
  },
  "dependencies": {
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-legacy": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/router": "catalog:",
    "antlr4": "catalog:",
    "idb": "catalog:",
    "lodash-es": "catalog:",
    "normalize.css": "catalog:",
    "p-limit": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unplugin-data": "catalog:",
    "unplugin-import-defer": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.5.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.7.0",
      "onFail": "error"
    }
  }
}
