{
  "name": "@android-cs/api-query",
  "version": "0.4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/android-cs/android-api-diff",
    "directory": "packages/api-query"
  },
  "engines": {
    "node": ">=26.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": "./dist/index.js",
      "./code": "./dist/code.js",
      "./code-render": "./dist/code-render.js",
      "./query": "./dist/query.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "test:code-render": "node scripts/code-render.test.ts",
    "test:query": "node scripts/query.test.ts",
    "type-check": "tsc"
  },
  "exports": {
    ".": "./src/index.ts",
    "./code": "./src/code.ts",
    "./code-render": "./src/code-render.ts",
    "./query": "./src/query.ts"
  },
  "dependencies": {
    "@android-cs/api-parser": "workspace:*",
    "p-limit": "catalog:"
  }
}
